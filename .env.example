# EmailJS credentials for the contact form
GATSBY_EMAIL_SERVICE_ID=
GATSBY_EMAIL_TEMPLATE_ID=
GATSBY_EMAIL_ACCOUNT_ID=

# Google Maps JS API key (used by the office map on the home page)
GATSBY_GOOGLE_MAP_API_KEY=

# reCAPTCHA v2 site key (optional - omit to disable the captcha widget)
GATSBY_RECAPTCHA_SITE_KEY=